# ══════════════════════════════════════════════════════════════════
# Chabrin Website — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local or any file containing real secrets.
# ══════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── PostgreSQL (Public Listings DB — website droplet only) ───────
# This is NOT the CHIPS database. Never use the CHIPS DB URL here.
DATABASE_URL=postgresql://postgres:password@localhost:5432/chabrin_public

# ── Vercel Blob (property image storage) ─────────────────────────
# Auto-injected by Vercel when a Blob store is connected to the project.
# In local dev, get this token from: Vercel Dashboard → Storage → Blob → your store → .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# ── Sanity CMS ────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_read_token

# ── Cloudflare Turnstile ──────────────────────────────────────────
# Get keys from: https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ── Mapbox ────────────────────────────────────────────────────────
# Get token from: https://account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token
